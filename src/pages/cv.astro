    <style>
      :root {
        --text: #111827;
        --muted: #4b5563;
        --line: #d1d5db;
        --bg: #ffffff;
        --accent: #1f2937;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: Arial, Helvetica, sans-serif;
        line-height: 1.5;
      }

      main {
        max-width: 980px;
        margin: 0 auto;
        padding: 32px 42px 40px;
      }

      header {
        border-bottom: 2px solid var(--line);
        padding-bottom: 12px;
        margin-bottom: 18px;
      }

      h1 {
        margin: 0;
        font-size: 30px;
        letter-spacing: 0.02em;
      }

      .subtitle {
        margin-top: 6px;
        font-size: 16px;
        font-weight: 700;
        color: var(--accent);
      }

      .contact {
        margin-top: 10px;
        font-size: 13px;
        color: var(--muted);
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .contact span,
      .contact a {
        white-space: nowrap;
      }

      .contact a {
        color: #0f172a;
        text-decoration: underline;
      }

      section {
        margin-top: 20px;
      }

      h2 {
        margin: 0 0 8px;
        padding-bottom: 6px;
        border-bottom: 1px solid var(--line);
        font-size: 16px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      p,
      li,
      span {
        font-size: 14px;
      }

      p {
        margin: 0 0 8px;
        color: var(--text);
      }

      ul {
        margin: 0;
        padding-left: 20px;
      }

      li {
        margin-bottom: 6px;
      }

      .two-columns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 30px;
      }

      .role {
        font-weight: 700;
      }

      .company {
        font-style: italic;
        color: var(--muted);
      }

      .period {
        color: var(--muted);
        font-size: 13px;
      }

      .skills-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        list-style: none;
        padding-left: 0;
      }

      .skills-list li {
        margin: 0;
        padding: 5px 9px;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        border-radius: 4px;
        font-size: 12px;
      }

      .no-print {
        display: block;
      }

      .print-actions {
        margin-top: 18px;
        text-align: center;
        font-size: 13px;
      }

      .print-actions button {
        background: #111827;
        color: #ffffff;
        border: none;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 700;
      }

      @media print {
        @page {
          size: A4;
          margin: 1.8cm 1.8cm 1.8cm 1.8cm;
        }

        body {
          font-size: 11pt;
          color: #000;
          background: #fff;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        main {
          max-width: 100%;
          padding: 0;
        }

        .no-print {
          display: none !important;
        }

        h1 {
          font-size: 24px;
        }

        h2 {
          font-size: 14px;
        }

        p,
        li,
        span {
          font-size: 10.8pt;
        }
      }
    </style>
  </head>

