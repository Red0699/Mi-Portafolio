---
import { PROJECTS } from "@/data/projects";
import { CERTIFICACIONES } from "@/data/certificaciones";
import { HABILIDADES } from "@/data/habilidades";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>CV de Nicolás Campos</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      /* Estilos generales */
      body {
        font-family: Arial, sans-serif;
        line-height: 1.5;
      }

      @media print {
        /* Márgenes de impresión */
        @page {
          size: A4;
          margin: 1.8cm 2cm 1.8cm 2cm; 
        }

        /* Ocultar encabezados y pies de página del navegador */
        @page {
          margin-top: 1.8cm;
          margin-bottom: 1.8cm;
        }

        /* Ajuste de cuerpo */
        body {
          font-size: 11.5pt;
          color: #000;
          background: #fff !important;
          max-width: 100%;
          padding: 0;
          margin: 0;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }

        /* Ocultar botones o elementos innecesarios */
        .no-print {
          display: none !important;
        }

        /* Control de saltos de página */
        .print-page-break {
          page-break-before: always;
        }

        /* Encabezado más compacto */
        header {
          margin-bottom: 10px;
          padding-bottom: 6px;
        }

        header h1 {
          font-size: 18pt;
        }

        header p {
          font-size: 10.5pt;
        }

        /* Títulos de sección */
        h2 {
          font-size: 13pt;
          margin-top: 14px;
          margin-bottom: 6px;
        }

        h3, h4, strong {
          font-size: 11.5pt;
        }

        /* Listas con mejor legibilidad */
        ul {
          margin: 4px 0 8px 18px;
        }
        li {
          margin-bottom: 3px;
        }
      }
    </style>
  </head>

  <body class="bg-white text-gray-900 font-sans px-6 py-12 max-w-3xl mx-auto print:px-0 print:py-0">
    <header class="border-b pb-4 mb-5">
      <h1 class="text-3xl font-bold">Yimmer Nicolás Campos Rojas</h1>
      <p class="text-lg text-gray-600">
        Ingeniero de Sistemas | Desarrollador
      </p>
      
      <p class="text-sm text-gray-500 mt-2">
        📍 Bogotá, Colombia · 📧 yimmernicolas@gmail.com · 📞 +57 3214663210 ·
        🌐
        <a
          href="https://nicolascampos-web.vercel.app/"
          class="text-blue-600 hover:underline"
          target="_blank"
          rel="noopener"
        >
          nicolascampos-web.vercel.app
        </a>
      </p>
    </header>

    <!-- Perfil -->
    <section class="mb-6">
      <h2 class="text-xl font-semibold border-b pb-1 mb-2">Perfil</h2>
      <p class="text-sm leading-relaxed text-gray-700">
        Ingeniero de Sistemas enfocado en Desarrollo Web Full Stack y Análisis de Datos. Experiencia en el diseño y arquitectura de plataformas web utilizando Laravel, Node.js, Angular y bases de datos relacionales y no relacionales (MySQL, MongoDB).
      </p>

      <!-- Educación -->
      <section class="mb-8 mt-6">
        <h2 class="text-xl font-semibold border-b pb-1 mb-2">Educación</h2>
        <div>
          <h3 class="text-lg font-medium text-gray-800">Ingeniería de Sistemas</h3>
          <p class="text-sm text-gray-600">
            Universidad de Cundinamarca — Febrero 2018 - Marzo 2024
          </p>
          <p class="text-sm text-gray-500 mt-1">
            Formación orientada al desarrollo de software, análisis de datos y
            metodologías ágiles.
          </p>
        </div>
      </section>

      <!-- Experiencia laboral -->
      <section class="mb-6 mt-6">
        <h2 class="text-xl font-semibold border-b pb-1 mb-2">
          Experiencia Laboral
        </h2>
        <ul class="space-y-6 text-sm">
          <!-- Experiencia 1 -->
          <li>
            <strong>Desarrollo de Sistema de Gestión de Casos en Excel con VBA</strong> · 
            <span class="italic">LOI Soluciones</span>
            <p class="text-gray-500">Julio 2025 - Noviembre 2025</p>
            <ul class="list-disc pl-5 text-gray-700 mt-3 space-y-1">
              <li><strong>Eficiencia operativa:</strong> Reducción de más del 60% en el tiempo de gestión de datos mediante la automatización de procesos manuales en entornos Excel.</li>
              <li><strong>Desarrollo técnico:</strong> Creación desde cero de una herramienta basada en VBA y macros enfocada en estructurar, filtrar y procesar información de casos jurídicos.</li>
              <li><strong>Mitigación de errores:</strong> Implementación de validaciones automáticas de datos y módulos de conversión de formatos (texto a fecha), elevando la precisión de los reportes gerenciales.</li>
              <li><strong>Experiencia de usuario:</strong> Diseño de módulos de búsqueda avanzada para agilizar la localización y cruce de datos de inquilinos y propietarios.</li>
            </ul>
          </li>

          <!-- Experiencia 2 -->
          <li>
            <strong>Proyecto de Grado - Plataforma de Inventario Digital</strong> · 
            <span class="italic">Instituto Distrital de Recreación y Deporte (IDRD)</span>
            <p class="text-gray-500">Noviembre 2022 - Mayo 2023</p>
            <ul class="list-disc pl-5 text-gray-700 mt-3 space-y-1">
              <li><strong>Desarrollo Full Stack:</strong> Diseño y construcción desde cero de una plataforma web (Laravel, MySQL, JavaScript) para la digitalización del inventario de parques, eliminando el procesamiento manual y mejorando la trazabilidad de recursos.</li>
              <li><strong>Metodología ágil:</strong> Implementación de Scrum (sprints y retrospectivas) para la planificación del proyecto, garantizando entregas puntuales y la documentación de más de 15 funcionalidades.</li>
              <li><strong>Optimización y escala:</strong> Arquitectura escalable que permitió gestionar más de 100 registros de inventario con módulos de búsqueda avanzada y reportes en tiempo real.</li>
              <li><strong>Calidad de datos:</strong> Reducción de errores en la manipulación de información en más de un 80% mediante la integración de validaciones automáticas en el sistema.</li>
            </ul>
          </li>
        </ul>
      </section>
    </section>

    <!-- Proyectos -->
    <section class="mb-6">
      <h2 class="text-xl font-semibold border-b pb-1 mb-2">Proyectos Destacados</h2>
      <ul class="space-y-4 text-sm">
        {
          PROJECTS.slice(0, 3).map(({ title, description, github }) => (
            <li>
              <strong>{title}</strong>
              <p class="text-gray-700">{description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Habilidades -->
    <section class="mb-6">
      <h2 class="text-xl font-semibold border-b pb-1 mb-2">Habilidades Técnicas</h2>
      <ul class="flex flex-wrap gap-2 text-sm">
        {
          PROJECTS.flatMap((p) => p.tags.map((tag) => tag.name))
            .filter((value, index, self) => self.indexOf(value) === index)
            .map((skill) => (
              <li class="bg-gray-200 text-gray-800 px-2 py-1 rounded">{skill}</li>
            ))
        }
        <li class="bg-gray-200 text-gray-800 px-2 py-1 rounded">Linux</li>
        <li class="bg-gray-200 text-gray-800 px-2 py-1 rounded">SAP</li>
        <li class="bg-gray-200 text-gray-800 px-2 py-1 rounded">Excel</li>
      </ul>
    </section>

    <!-- Certificaciones -->
    <section class="mb-6">
      <h2 class="text-xl font-semibold border-b pb-1 mb-2">Certificaciones & Formaciones</h2>
      <div class="text-sm space-y-2">
        <p><strong>Backend & APIs (Platzi):</strong> APIs .NET, Fundamentos .NET, Entity Framework, Node.js, Bases de Datos Relacionales</p>
        <p><strong>Frontend & Web (Platzi):</strong> Angular 17, Frontend Developer, JavaScript</p>
        <p><strong>Java & Spring Boot (Alura):</strong> Java & Spring Boot G4, Java Web, Oracle ONE, Integración BD</p>
        <p><strong>Full Stack (Mastermind):</strong> Desarrollo Full Stack con Laravel & VueJS</p>
        <p><strong>Herramientas & Certificaciones (Alura, SENA, Colsubsidio):</strong> Excel Avanzado, Emprendimiento, Agilidad, QA, BD Generalidades</p>
      </div>
    </section>

    <footer class="text-center text-sm text-gray-500 mt-10 no-print">
      <button onclick="window.print()" class="text-blue-600 hover:underline">
        🖨️ Imprimir / Descargar en PDF
      </button>
    </footer>
  </body>
</html>
