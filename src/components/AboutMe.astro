---
import MailIcon from "@/components/icons/Mail.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";

const personalImageAlt = "Yimmer Nicolás Campos Rojas";

const services = [
  {
    title: "Desarrollo web",
    description: "Aplicaciones y funcionalidades para organizar procesos y facilitar el trabajo diario.",
  },
  {
    title: "Automatización",
    description: "Herramientas con Excel y VBA para reducir tareas manuales y ordenar información.",
  },
  {
    title: "Análisis de datos",
    description: "Preparación y visualización de datos con Excel, Python, Looker Studio y Power BI.",
  },
];
---

<article class="grid items-center gap-8 md:grid-cols-[minmax(0,1fr)_15rem] md:gap-12">
  <div>
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-300">
      Tecnología con propósito
    </p>
    <h3 class="mb-4 text-2xl font-bold leading-tight text-slate-900 dark:text-white md:text-3xl">
      Convierto necesidades operativas en soluciones digitales prácticas.
    </h3>
    <div class="space-y-4 text-base leading-relaxed text-slate-600 dark:text-slate-300">
      <p>
        Soy Yimmer Nicolás Campos Rojas, Ingeniero de Sistemas y desarrollador de software en Bogotá. Trabajo en soluciones web y automatización, y complemento mi perfil con formación en análisis de datos.
      </p>
      <p>
        He desarrollado proyectos con Laravel, Angular, Node.js y MySQL, además de herramientas de gestión en Excel con VBA. En mi proyecto de grado construí una plataforma para apoyar la gestión de inventario de parques del IDRD, con búsqueda, validación de datos y reportes.
      </p>
    </div>

    <ul class="mt-7 grid gap-3 sm:grid-cols-3" aria-label="Áreas en las que puedo ayudarte">
      {
        services.map(({ title, description }) => (
          <li class="rounded-xl border border-slate-200 bg-white/70 p-4 dark:border-slate-700 dark:bg-slate-900/70">
            <h4 class="text-sm font-bold text-slate-900 dark:text-white">{title}</h4>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{description}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-7 flex flex-wrap gap-3">
      <a
        href="mailto:yimmernicolas@gmail.com?subject=Conversemos%20sobre%20un%20proyecto"
        class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:bg-indigo-500 dark:hover:bg-indigo-400"
      >
        <MailIcon class="size-4" />
        Hablemos de tu proyecto
      </a>
      <a
        href="https://www.linkedin.com/in/nicolas-campos-72a1a11a4/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-indigo-300 hover:bg-indigo-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:border-slate-600 dark:text-slate-200 dark:hover:border-indigo-400 dark:hover:bg-indigo-400/10"
      >
        <LinkedInIcon class="size-4" />
        Conectemos en LinkedIn
      </a>
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-[15rem]">
    <div class="absolute -inset-3 rounded-[2rem] bg-gradient-to-br from-sky-400/25 via-indigo-400/15 to-fuchsia-400/25 blur-xl" aria-hidden="true"></div>
    <img
      width="240"
      height="300"
      src="/img/my-photo.webp"
      alt={personalImageAlt}
      loading="lazy"
      class="relative aspect-[4/5] w-full rounded-[1.5rem] border border-white/70 object-cover shadow-xl dark:border-slate-700"
      style="object-position: 50% 50%"
    />
    <p class="relative mx-auto -mt-5 w-fit rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-md dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
      Bogotá, Colombia
    </p>
  </div>
</article>
