---
import { CERTIFICACIONES } from "@/data/certificaciones";
import LinkIcon from "@/components/icons/Link.astro";
---

<section class="py-5">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <p class="max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-300">
      Cursos y programas que complementan mi formación en tecnología, desarrollo y análisis de datos.
    </p>
    <span
      class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-sm font-semibold text-indigo-700 dark:border-indigo-400/20 dark:bg-indigo-400/10 dark:text-indigo-300"
    >
      <span class="size-2 rounded-full bg-indigo-500" aria-hidden="true"></span>
      {CERTIFICACIONES.length} certificaciones
    </span>
  </div>

  <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3" aria-label="Listado de certificaciones">
    {
      CERTIFICACIONES.map((cert) => (
        <li class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-indigo-300 hover:shadow-xl hover:shadow-indigo-950/10 dark:border-slate-700 dark:bg-slate-900 dark:hover:border-indigo-400/60">
          <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-sky-400 via-indigo-500 to-violet-500 opacity-70 transition-opacity group-hover:opacity-100" aria-hidden="true"></div>
          <div class="flex flex-1 items-start gap-4">
            {cert.logo ? (
              <div class="flex size-12 shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-white p-2 shadow-sm dark:border-slate-700 dark:bg-slate-800">
                <img
                  src={cert.logo}
                  alt={`Logo de ${cert.emisor}`}
                  loading="lazy"
                  class="max-h-full max-w-full object-contain"
                />
              </div>
            ) : (
              <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-lg font-bold text-indigo-600 dark:bg-indigo-400/10 dark:text-indigo-300" aria-hidden="true">
                {cert.emisor.charAt(0)}
              </div>
            )}
            <div class="min-w-0">
              <p class="mb-1 text-xs font-semibold uppercase tracking-[0.12em] text-indigo-600 dark:text-indigo-300">
                {cert.emisor}
              </p>
              <h3 class="text-base font-semibold leading-snug text-slate-900 dark:text-white">
                {cert.titulo}
              </h3>
            </div>
          </div>

          <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4 dark:border-slate-800">
            <span class="inline-flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
              <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3.5" y="5" width="17" height="15.5" rx="2" />
                <path d="M7.5 3.5v3M16.5 3.5v3M3.5 9.5h17" />
              </svg>
              {cert.expedicion}
            </span>
            {cert.link && (
              <a
                href={cert.link}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Ver certificación ${cert.titulo} de ${cert.emisor} en una nueva pestaña`}
                class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm font-semibold text-indigo-600 transition-colors hover:bg-indigo-50 hover:text-indigo-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:text-indigo-300 dark:hover:bg-indigo-400/10 dark:hover:text-indigo-200"
              >
                <LinkIcon class="size-4" />
                Ver credencial
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</section>
