---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  {
    title: "Inicio",
    label: "inicio",
    url: "/#inicio",
  },
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },

  {
    title: "Certificaciones",
    label: "certificaciones",
    url: "/#certificaciones",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
];
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    class="flex flex-wrap justify-center items-center px-3 text-[9px] sm:text-xs md:text-sm font-medium rounded-full text-gray-600 dark:text-gray-200"
  >
    {
      navItems.map((link) => (
        <a
          class="relative block px-2 py-2 transition hover:text-red-500 dark:hover:text-red-400"
          data-section={link.label}
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const navItems = document.querySelectorAll("header nav a[data-section]");
    const sections = document.querySelectorAll<HTMLElement>("section[data-section]");

    const setActiveLink = (id: string | null) => {
      navItems.forEach((item) => {
        const isActive = item.getAttribute("data-section") === id;
        item.classList.toggle("text-red-500", isActive);
        item.classList.toggle("dark:text-red-400", isActive);
        item.classList.toggle("font-semibold", isActive);
      });
    };

    const updateActiveLink = () => {
      const activationLine = window.scrollY + window.innerHeight * 0.35;
      let activeSection = sections[0] ?? null;

      sections.forEach((section) => {
        if (section.getBoundingClientRect().top + window.scrollY <= activationLine) {
          activeSection = section;
        }
      });

      if (
        window.scrollY + window.innerHeight >=
        document.documentElement.scrollHeight - 2
      ) {
        activeSection = sections[sections.length - 1] ?? activeSection;
      }

      setActiveLink(activeSection?.dataset.section ?? null);
    };

    let frameRequested = false;
    const handleScroll = () => {
      if (frameRequested) return;

      frameRequested = true;
      window.requestAnimationFrame(() => {
        updateActiveLink();
        frameRequested = false;
      });
    };

    updateActiveLink();
    window.addEventListener("scroll", handleScroll, { passive: true });
    window.addEventListener("resize", handleScroll);
  });
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-shadown {
    to {
      @apply shadow-lg ring-1 backdrop-blur bg-gray-300/60 dark:bg-gray-800/60 ring-white/10;
    }
  }
</style>
